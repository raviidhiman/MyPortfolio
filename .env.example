# Copy to .env (never commit .env). Set these as environment variables on your host.
NODE_ENV=production
PORT=3000
# PostgreSQL connection string (Supabase/Neon/Render Postgres all work; use SSL options your provider requires)
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# Only this email can sign in to /admin
ADMIN_EMAIL=ravidhiman8673@gmail.com
# Long random string (e.g. `openssl rand -hex 32`). Required in production.
OTP_SECRET=
# Brevo (https://app.brevo.com) - API key + a verified sender address. Required in production to send login codes.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
